symbol: NVDA
exchange: SMART
currency: USD

notional_per_leg_usd: 100
sl_pct: 0.03
trailing_pct: 0.15

bar_size: "1 min"
cooldown_bars: 1

ibkr:
  host: 127.0.0.1
  port: 7497
  client_id: 1

# Timeouts / safety (new in v2)
entering_timeout_sec: 30.0
sl_live_timeout_sec: 2.0
cancel_timeout_sec: 2.0
trailing_live_timeout_sec: 2.0

reconcile_retries: 3
reconcile_retry_delay_sec: 0.25

# Optional
price_rounding: "cent"   # "cent" (default) or "minTick" (reserved)

log_level: INFO
